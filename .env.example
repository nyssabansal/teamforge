# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL 15+ with the pgvector extension
DATABASE_URL=postgres://teamforge:change-me@localhost:5432/teamforge
# set to true for hosted Postgres that requires SSL (Neon, Supabase, ...)
PGSSL=false

# MongoDB 6+
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=teamforge

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Invite codes required to sign up as organizer / judge
ORGANIZER_INVITE_CODE=
JUDGE_INVITE_CODE=
